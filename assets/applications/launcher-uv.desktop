[Desktop Entry]
Name=uv
Comment=uv (terminal)
Exec=$HOME/.local/bin/wezterm --config initial_cols=170 --config initial_rows=45 start --always-new-process --class uv -- bash -lc "uv; exec bash"
Icon=x47duster
Terminal=false
Type=Application
Categories=Development;Utility;
Keywords=pentest;security;hacking;uv;
StartupWMClass=uv
