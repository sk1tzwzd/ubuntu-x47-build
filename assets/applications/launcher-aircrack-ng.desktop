[Desktop Entry]
Name=Aircrack-ng
Comment=Aircrack-ng (terminal)
Exec=$HOME/.local/bin/wezterm --config initial_cols=170 --config initial_rows=45 start --always-new-process --class aircrack-ng -- bash -lc "aircrack-ng; exec bash"
Icon=kali-aircrack-ng
Terminal=false
Type=Application
Categories=Network;Security;
Keywords=pentest;security;hacking;aircrack-ng;
StartupWMClass=aircrack-ng
