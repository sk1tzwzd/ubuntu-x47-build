[Desktop Entry]
Name=Aircrack-ng
Comment=Aircrack-ng (terminal)
Exec=env X47_TERM_SIZE=tool $HOME/.local/bin/wezterm start --always-new-process --class aircrack-ng -- bash -lc "aircrack-ng; exec bash"
Icon=kali-aircrack-ng
Terminal=false
Type=Application
Categories=Network;Security;
Keywords=pentest;security;hacking;aircrack-ng;
StartupWMClass=aircrack-ng
