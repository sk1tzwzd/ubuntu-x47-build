[Desktop Entry]
Name=Subfinder
Comment=Subfinder (terminal)
Exec=env X47_TERM_SIZE=tool $HOME/.local/bin/wezterm start --always-new-process --class subfinder -- bash -lc "subfinder; exec bash"
Icon=kali-subfinder
Terminal=false
Type=Application
Categories=Network;Security;
Keywords=pentest;security;hacking;subfinder;
StartupWMClass=subfinder
