[Desktop Entry]
Name=Httpx
Comment=Httpx (terminal)
Exec=env X47_TERM_SIZE=tool $HOME/.local/bin/wezterm start --always-new-process --class httpx -- bash -lc "httpx; exec bash"
Icon=kali-cool-httpx
Terminal=false
Type=Application
Categories=Network;Security;
Keywords=pentest;security;hacking;httpx;
StartupWMClass=httpx
