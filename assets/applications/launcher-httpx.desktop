[Desktop Entry]
Name=Httpx
Comment=Httpx (terminal)
Exec=$HOME/.local/bin/wezterm --config initial_cols=170 --config initial_rows=45 start --always-new-process --class httpx -- bash -lc "httpx; exec bash"
Icon=kali-cool-httpx
Terminal=false
Type=Application
Categories=Network;Security;
Keywords=pentest;security;hacking;httpx;
StartupWMClass=httpx
