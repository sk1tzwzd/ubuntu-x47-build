[Desktop Entry]
Name=Bettercap
Comment=Bettercap (terminal)
Exec=$HOME/.local/bin/wezterm --config initial_cols=170 --config initial_rows=45 start --always-new-process --class bettercap -- bash -lc "bettercap; exec bash"
Icon=kali-bettercap
Terminal=false
Type=Application
Categories=Network;Security;
Keywords=pentest;security;hacking;bettercap;
StartupWMClass=bettercap
