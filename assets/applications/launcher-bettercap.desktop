[Desktop Entry]
Name=Bettercap
Comment=Bettercap (terminal)
Exec=env X47_TERM_SIZE=tool $HOME/.local/bin/wezterm start --always-new-process --class bettercap -- bash -lc "bettercap; exec bash"
Icon=kali-bettercap
Terminal=false
Type=Application
Categories=Network;Security;
Keywords=pentest;security;hacking;bettercap;
StartupWMClass=bettercap
