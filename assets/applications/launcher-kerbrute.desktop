[Desktop Entry]
Name=kerbrute
Comment=kerbrute (terminal)
Exec=env X47_TERM_SIZE=tool $HOME/.local/bin/wezterm start --always-new-process --class kerbrute -- bash -lc "kerbrute; exec bash"
Icon=x47-kerbrute
Terminal=false
Type=Application
Categories=Network;Security;
Keywords=pentest;security;hacking;kerbrute;
StartupWMClass=kerbrute
