[Desktop Entry]
Name=DNSx
Comment=DNSx (terminal)
Exec=$HOME/.local/bin/wezterm --config initial_cols=170 --config initial_rows=45 start --always-new-process --class dnsx -- bash -lc "dnsx; exec bash"
Icon=x47duster
Terminal=false
Type=Application
Categories=Network;Security;
Keywords=pentest;security;hacking;dnsx;
StartupWMClass=dnsx
