[Desktop Entry]
Name=DNSx
Comment=DNSx (terminal)
Exec=env X47_TERM_SIZE=tool $HOME/.local/bin/wezterm start --always-new-process --class dnsx -- bash -lc "dnsx; exec bash"
Icon=x47-dnsx
Terminal=false
Type=Application
Categories=Network;Security;
Keywords=pentest;security;hacking;dnsx;
StartupWMClass=dnsx
