[Desktop Entry]
Name=Assetfinder
Comment=Assetfinder (terminal)
Exec=env X47_TERM_SIZE=tool $HOME/.local/bin/wezterm start --always-new-process --class assetfinder -- bash -lc "assetfinder; exec bash"
Icon=kali-cool-assetfinder
Terminal=false
Type=Application
Categories=Network;Security;
Keywords=pentest;security;hacking;assetfinder;
StartupWMClass=assetfinder
