[Desktop Entry]
Name=enum4linux-ng
Comment=enum4linux-ng (terminal)
Exec=$HOME/.local/bin/wezterm --config initial_cols=170 --config initial_rows=45 start --always-new-process --class enum4linux-ng -- bash -lc "enum4linux-ng; exec bash"
Icon=kali-enum4linux-ng
Terminal=false
Type=Application
Categories=Network;Security;
Keywords=pentest;security;hacking;enum4linux-ng;
StartupWMClass=enum4linux-ng
