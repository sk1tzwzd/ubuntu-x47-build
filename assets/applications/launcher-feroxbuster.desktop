[Desktop Entry]
Name=Feroxbuster
Comment=Feroxbuster (terminal)
Exec=$HOME/.local/bin/wezterm --config initial_cols=170 --config initial_rows=45 start --always-new-process --class feroxbuster -- bash -lc "feroxbuster; exec bash"
Icon=kali-feroxbuster
Terminal=false
Type=Application
Categories=Network;Security;
Keywords=pentest;security;hacking;feroxbuster;
StartupWMClass=feroxbuster
