[Desktop Entry]
Name=Feroxbuster
Comment=Feroxbuster (terminal)
Exec=env X47_TERM_SIZE=tool $HOME/.local/bin/wezterm start --always-new-process --class feroxbuster -- bash -lc "feroxbuster; exec bash"
Icon=kali-feroxbuster
Terminal=false
Type=Application
Categories=Network;Security;
Keywords=pentest;security;hacking;feroxbuster;
StartupWMClass=feroxbuster
