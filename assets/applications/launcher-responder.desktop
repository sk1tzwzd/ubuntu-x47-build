[Desktop Entry]
Name=Responder
Comment=Responder (terminal)
Exec=$HOME/.local/bin/wezterm --config initial_cols=170 --config initial_rows=45 start --always-new-process --class responder -- bash -lc "sudo responder -I eth0; exec bash"
Icon=kali-responder
Terminal=false
Type=Application
Categories=Network;Security;
Keywords=pentest;security;hacking;responder;
StartupWMClass=responder
