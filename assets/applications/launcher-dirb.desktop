[Desktop Entry]
Name=Dirb
Comment=Dirb (terminal)
Exec=env X47_TERM_SIZE=tool $HOME/.local/bin/wezterm start --always-new-process --class dirb -- bash -lc "dirb; exec bash"
Icon=kali-dirb
Terminal=false
Type=Application
Categories=Network;Security;
Keywords=pentest;security;hacking;dirb;
StartupWMClass=dirb
