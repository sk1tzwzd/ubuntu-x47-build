[Desktop Entry]
Name=Dirb
Comment=Dirb (terminal)
Exec=$HOME/.local/bin/wezterm --config initial_cols=170 --config initial_rows=45 start --always-new-process --class dirb -- bash -lc "dirb; exec bash"
Icon=kali-dirb
Terminal=false
Type=Application
Categories=Network;Security;
Keywords=pentest;security;hacking;dirb;
StartupWMClass=dirb
