[Desktop Entry]
Name=Hashcat
Comment=Hashcat (terminal)
Exec=env X47_TERM_SIZE=tool $HOME/.local/bin/wezterm start --always-new-process --class hashcat -- bash -lc "hashcat; exec bash"
Icon=kali-hashcat
Terminal=false
Type=Application
Categories=Security;
Keywords=pentest;security;hacking;hashcat;
StartupWMClass=hashcat
