[Desktop Entry]
Name=RustScan
Comment=RustScan (terminal)
Exec=$HOME/.local/bin/wezterm --config initial_cols=170 --config initial_rows=45 start --always-new-process --class rustscan -- bash -lc "rustscan; exec bash"
Icon=x47-rustscan
Terminal=false
Type=Application
Categories=Network;Security;
Keywords=pentest;security;hacking;rustscan;
StartupWMClass=rustscan
