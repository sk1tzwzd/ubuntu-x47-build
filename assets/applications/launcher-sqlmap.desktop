[Desktop Entry]
Name=SQLMap
Comment=SQLMap (terminal)
Exec=env X47_TERM_SIZE=tool $HOME/.local/bin/wezterm start --always-new-process --class sqlmap -- bash -lc "sqlmap; exec bash"
Icon=kali-sqlmap
Terminal=false
Type=Application
Categories=Network;Security;
Keywords=pentest;security;hacking;sqlmap;
StartupWMClass=sqlmap
