[Desktop Entry]
Name=interactsh-client
Comment=interactsh-client (terminal)
Exec=$HOME/.local/bin/wezterm --config initial_cols=170 --config initial_rows=45 start --always-new-process --class interactsh-client -- bash -lc "interactsh-client; exec bash"
Icon=x47duster
Terminal=false
Type=Application
Categories=Network;Security;
Keywords=pentest;security;hacking;interactsh-client;
StartupWMClass=interactsh-client
