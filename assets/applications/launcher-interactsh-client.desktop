[Desktop Entry]
Name=interactsh-client
Comment=interactsh-client (terminal)
Exec=env X47_TERM_SIZE=tool $HOME/.local/bin/wezterm start --always-new-process --class interactsh-client -- bash -lc "interactsh-client; exec bash"
Icon=x47-interactsh-client
Terminal=false
Type=Application
Categories=Network;Security;
Keywords=pentest;security;hacking;interactsh-client;
StartupWMClass=interactsh-client
