[Desktop Entry]
Name=Binwalk
Comment=Binwalk (terminal)
Exec=env X47_TERM_SIZE=tool $HOME/.local/bin/wezterm start --always-new-process --class binwalk -- bash -lc "binwalk; exec bash"
Icon=kali-binwalk
Terminal=false
Type=Application
Categories=Security;
Keywords=pentest;security;hacking;binwalk;
StartupWMClass=binwalk
