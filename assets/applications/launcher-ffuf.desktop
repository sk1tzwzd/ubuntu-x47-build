[Desktop Entry]
Name=FFUF
Comment=FFUF (terminal)
Exec=env X47_TERM_SIZE=tool $HOME/.local/bin/wezterm start --always-new-process --class ffuf -- bash -lc "ffuf; exec bash"
Icon=kali-ffuf
Terminal=false
Type=Application
Categories=Network;Security;
Keywords=pentest;security;hacking;ffuf;
StartupWMClass=ffuf
