[Desktop Entry]
Name=TLSx
Comment=TLSx (terminal)
Exec=env X47_TERM_SIZE=tool $HOME/.local/bin/wezterm start --always-new-process --class tlsx -- bash -lc "tlsx; exec bash"
Icon=x47-tlsx
Terminal=false
Type=Application
Categories=Network;Security;
Keywords=pentest;security;hacking;tlsx;
StartupWMClass=tlsx
