[Desktop Entry]
Name=Hydra
Comment=Hydra (terminal)
Exec=env X47_TERM_SIZE=tool $HOME/.local/bin/wezterm start --always-new-process --class hydra -- bash -lc "hydra; exec bash"
Icon=kali-hydra
Terminal=false
Type=Application
Categories=Network;Security;
Keywords=pentest;security;hacking;hydra;
StartupWMClass=hydra
