[Desktop Entry]
Name=Hydra
Comment=Hydra (terminal)
Exec=$HOME/.local/bin/wezterm --config initial_cols=170 --config initial_rows=45 start --always-new-process --class hydra -- bash -lc "hydra; exec bash"
Icon=kali-hydra
Terminal=false
Type=Application
Categories=Network;Security;
Keywords=pentest;security;hacking;hydra;
StartupWMClass=hydra
