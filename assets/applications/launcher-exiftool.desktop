[Desktop Entry]
Name=ExifTool
Comment=ExifTool (terminal)
Exec=$HOME/.local/bin/wezterm --config initial_cols=170 --config initial_rows=45 start --always-new-process --class exiftool -- bash -lc "exiftool; exec bash"
Icon=kali-forensics
Terminal=false
Type=Application
Categories=Utility;
Keywords=pentest;security;hacking;exiftool;
StartupWMClass=exiftool
