[Desktop Entry]
Name=ExifTool
Comment=ExifTool (terminal)
Exec=env X47_TERM_SIZE=tool $HOME/.local/bin/wezterm start --always-new-process --class exiftool -- bash -lc "exiftool; exec bash"
Icon=kali-forensics
Terminal=false
Type=Application
Categories=Utility;
Keywords=pentest;security;hacking;exiftool;
StartupWMClass=exiftool
