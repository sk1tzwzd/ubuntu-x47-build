[Desktop Entry]
Name=Naabu
Comment=Naabu (terminal)
Exec=env X47_TERM_SIZE=tool $HOME/.local/bin/wezterm start --always-new-process --class naabu -- bash -lc "naabu; exec bash"
Icon=kali-cool-naabu
Terminal=false
Type=Application
Categories=Network;Security;
Keywords=pentest;security;hacking;naabu;
StartupWMClass=naabu
