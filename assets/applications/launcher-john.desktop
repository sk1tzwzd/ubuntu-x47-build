[Desktop Entry]
Name=John the Ripper
Comment=John the Ripper (terminal)
Exec=env X47_TERM_SIZE=tool $HOME/.local/bin/wezterm start --always-new-process --class john -- bash -lc "john; exec bash"
Icon=kali-john
Terminal=false
Type=Application
Categories=Security;
Keywords=pentest;security;hacking;john;
StartupWMClass=john
