[Desktop Entry]
Name=Katana
Comment=Katana (terminal)
Exec=env X47_TERM_SIZE=tool $HOME/.local/bin/wezterm start --always-new-process --class katana -- bash -lc "katana; exec bash"
Icon=kali-cool-katana
Terminal=false
Type=Application
Categories=Network;Security;
Keywords=pentest;security;hacking;katana;
StartupWMClass=katana
