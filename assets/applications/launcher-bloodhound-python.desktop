[Desktop Entry]
Name=bloodhound-python
Comment=bloodhound-python (terminal)
Exec=env X47_TERM_SIZE=tool $HOME/.local/bin/wezterm start --always-new-process --class bloodhound-python -- bash -lc "bloodhound-python; exec bash"
