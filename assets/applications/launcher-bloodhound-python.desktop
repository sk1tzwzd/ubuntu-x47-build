[Desktop Entry]
Name=bloodhound-python
Comment=bloodhound-python (terminal)
Exec=$HOME/.local/bin/wezterm --config initial_cols=170 --config initial_rows=45 start --always-new-process --class bloodhound-python -- bash -lc "bloodhound-python; exec bash"
Icon=kali-bloodhound-python
Terminal=false
Type=Application
Categories=Network;Security;
Keywords=pentest;security;hacking;bloodhound-python;
