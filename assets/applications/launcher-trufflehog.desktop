[Desktop Entry]
Name=trufflehog
Comment=trufflehog (terminal)
Exec=env X47_TERM_SIZE=tool $HOME/.local/bin/wezterm start --always-new-process --class trufflehog -- bash -lc "trufflehog; exec bash"
Icon=x47-trufflehog
Terminal=false
Type=Application
Categories=Network;Security;
Keywords=pentest;security;hacking;trufflehog;
StartupWMClass=trufflehog
