[Desktop Entry]
Name=Dalfox
Comment=Dalfox (terminal)
Exec=env X47_TERM_SIZE=tool $HOME/.local/bin/wezterm start --always-new-process --class dalfox -- bash -lc "dalfox; exec bash"
Icon=x47-dalfox
Terminal=false
Type=Application
Categories=Network;Security;
Keywords=pentest;security;hacking;dalfox;
StartupWMClass=dalfox
