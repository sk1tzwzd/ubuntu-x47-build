[Desktop Entry]
Name=gau
Comment=gau (terminal)
Exec=$HOME/.local/bin/wezterm --config initial_cols=170 --config initial_rows=45 start --always-new-process --class gau -- bash -lc "gau; exec bash"
Icon=x47duster
Terminal=false
Type=Application
Categories=Network;Security;
Keywords=pentest;security;hacking;gau;
StartupWMClass=gau
