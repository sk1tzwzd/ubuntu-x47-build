[Desktop Entry]
Name=gau
Comment=gau (terminal)
Exec=env X47_TERM_SIZE=tool $HOME/.local/bin/wezterm start --always-new-process --class gau -- bash -lc "gau; exec bash"
Icon=x47-gau
Terminal=false
Type=Application
Categories=Network;Security;
Keywords=pentest;security;hacking;gau;
StartupWMClass=gau
