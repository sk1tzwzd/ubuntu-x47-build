[Desktop Entry]
Name=Nikto
Comment=Nikto (terminal)
Exec=env X47_TERM_SIZE=tool $HOME/.local/bin/wezterm start --always-new-process --class nikto -- bash -lc "nikto; exec bash"
Icon=kali-nikto
Terminal=false
Type=Application
Categories=Network;Security;
Keywords=pentest;security;hacking;nikto;
StartupWMClass=nikto
