[Desktop Entry]
Name=Nikto
Comment=Nikto (terminal)
Exec=$HOME/.local/bin/wezterm --config initial_cols=170 --config initial_rows=45 start --always-new-process --class nikto -- bash -lc "nikto; exec bash"
Icon=kali-nikto
Terminal=false
Type=Application
Categories=Network;Security;
Keywords=pentest;security;hacking;nikto;
StartupWMClass=nikto
