[Desktop Entry]
Name=NetExec
Comment=NetExec (terminal)
Exec=$HOME/.local/bin/wezterm --config initial_cols=170 --config initial_rows=45 start --always-new-process --class nxc -- bash -lc "nxc; exec bash"
Icon=kali-netexec
Terminal=false
Type=Application
Categories=Network;Security;
Keywords=pentest;security;hacking;nxc;
StartupWMClass=nxc
