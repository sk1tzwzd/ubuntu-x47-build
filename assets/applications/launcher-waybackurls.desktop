[Desktop Entry]
Name=Waybackurls
Comment=Waybackurls (terminal)
Exec=env X47_TERM_SIZE=tool $HOME/.local/bin/wezterm start --always-new-process --class waybackurls -- bash -lc "waybackurls; exec bash"
Icon=kali-cool-waybackurls
Terminal=false
Type=Application
Categories=Network;Security;
Keywords=pentest;security;hacking;waybackurls;
StartupWMClass=waybackurls
