[Desktop Entry]
Name=gitleaks
Comment=gitleaks (terminal)
Exec=env X47_TERM_SIZE=tool $HOME/.local/bin/wezterm start --always-new-process --class gitleaks -- bash -lc "gitleaks; exec bash"
Icon=x47-gitleaks
Terminal=false
Type=Application
Categories=Network;Security;
Keywords=pentest;security;hacking;gitleaks;
StartupWMClass=gitleaks
