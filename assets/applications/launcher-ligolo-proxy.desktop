[Desktop Entry]
Name=Ligolo-ng Proxy
Comment=Ligolo-ng Proxy (terminal)
Exec=env X47_TERM_SIZE=tool $HOME/.local/bin/wezterm start --always-new-process --class ligolo-proxy -- bash -lc "ligolo-proxy; exec bash"
Icon=kali-ligolo-proxy
Terminal=false
Type=Application
Categories=Network;Security;
Keywords=pentest;security;hacking;ligolo-proxy;
StartupWMClass=ligolo-proxy
