[Desktop Entry]
Name=Nmap
Comment=Nmap (terminal)
Exec=$HOME/.local/bin/wezterm --config initial_cols=170 --config initial_rows=45 start --always-new-process --class nmap -- bash -lc "nmap; exec bash"
Icon=kali-nmap
Terminal=false
Type=Application
Categories=Network;Security;
Keywords=pentest;security;hacking;nmap;
StartupWMClass=nmap
