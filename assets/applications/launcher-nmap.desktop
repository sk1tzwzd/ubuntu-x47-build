[Desktop Entry]
Name=Nmap
Comment=Nmap (terminal)
Exec=env X47_TERM_SIZE=tool $HOME/.local/bin/wezterm start --always-new-process --class nmap -- bash -lc "nmap; exec bash"
Icon=kali-nmap
Terminal=false
Type=Application
Categories=Network;Security;
Keywords=pentest;security;hacking;nmap;
StartupWMClass=nmap
