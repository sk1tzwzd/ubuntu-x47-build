[Desktop Entry]
Name=WhatWeb
Comment=WhatWeb (terminal)
Exec=$HOME/.local/bin/wezterm --config initial_cols=170 --config initial_rows=45 start --always-new-process --class whatweb -- bash -lc "whatweb; exec bash"
