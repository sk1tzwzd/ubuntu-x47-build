[Desktop Entry]
Name=WhatWeb
Comment=WhatWeb (terminal)
Exec=env X47_TERM_SIZE=tool $HOME/.local/bin/wezterm start --always-new-process --class whatweb -- bash -lc "whatweb; exec bash"
Icon=kali-whatweb
Terminal=false
Type=Application
Categories=Network;Security;
Keywords=pentest;security;hacking;whatweb;
StartupWMClass=whatweb
