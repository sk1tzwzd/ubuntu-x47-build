[Desktop Entry]
Name=Gobuster
Comment=Gobuster (terminal)
Exec=$HOME/.local/bin/wezterm --config initial_cols=170 --config initial_rows=45 start --always-new-process --class gobuster -- bash -lc "gobuster; exec bash"
Icon=kali-gobuster
Terminal=false
Type=Application
Categories=Network;Security;
Keywords=pentest;security;hacking;gobuster;
StartupWMClass=gobuster
