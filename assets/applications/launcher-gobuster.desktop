[Desktop Entry]
Name=Gobuster
Comment=Gobuster (terminal)
Exec=env X47_TERM_SIZE=tool $HOME/.local/bin/wezterm start --always-new-process --class gobuster -- bash -lc "gobuster; exec bash"
Icon=kali-gobuster
Terminal=false
Type=Application
Categories=Network;Security;
Keywords=pentest;security;hacking;gobuster;
StartupWMClass=gobuster
