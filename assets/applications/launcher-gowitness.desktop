[Desktop Entry]
Name=gowitness
Comment=gowitness (terminal)
Exec=env X47_TERM_SIZE=tool $HOME/.local/bin/wezterm start --always-new-process --class gowitness -- bash -lc "gowitness; exec bash"
Icon=x47-gowitness
Terminal=false
Type=Application
Categories=Network;Security;
Keywords=pentest;security;hacking;gowitness;
StartupWMClass=gowitness
