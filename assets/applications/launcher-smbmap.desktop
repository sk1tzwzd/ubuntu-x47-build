[Desktop Entry]
Name=smbmap
Comment=smbmap (terminal)
Exec=env X47_TERM_SIZE=tool $HOME/.local/bin/wezterm start --always-new-process --class smbmap -- bash -lc "smbmap; exec bash"
Icon=kali-smbmap
Terminal=false
Type=Application
Categories=Network;Security;
Keywords=pentest;security;hacking;smbmap;
StartupWMClass=smbmap
