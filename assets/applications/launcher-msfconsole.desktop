[Desktop Entry]
Name=Metasploit
Comment=Metasploit (terminal)
Exec=env X47_TERM_SIZE=tool $HOME/.local/bin/wezterm start --always-new-process --class msfconsole -- bash -lc "msfconsole; exec bash"
Icon=kali-metasploit-framework
Terminal=false
Type=Application
Categories=Network;Security;
Keywords=pentest;security;hacking;msfconsole;
StartupWMClass=msfconsole
