[Desktop Entry]
Name=Impacket SMBServer
Comment=Impacket SMBServer (terminal)
Exec=env X47_TERM_SIZE=tool $HOME/.local/bin/wezterm start --always-new-process --class smbserver.py -- bash -lc "smbserver.py; exec bash"
Icon=kali-impacket-smbserver
Terminal=false
Type=Application
Categories=Network;Security;
Keywords=pentest;security;hacking;smbserver.py;
StartupWMClass=smbserver.py
