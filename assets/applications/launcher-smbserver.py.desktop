[Desktop Entry]
Name=Impacket SMBServer
Comment=Impacket SMBServer (terminal)
Exec=$HOME/.local/bin/wezterm --config initial_cols=170 --config initial_rows=45 start --always-new-process --class smbserver.py -- bash -lc "smbserver.py; exec bash"
Icon=kali-impacket-smbserver
Terminal=false
Type=Application
Categories=Network;Security;
Keywords=pentest;security;hacking;smbserver.py;
StartupWMClass=smbserver.py
