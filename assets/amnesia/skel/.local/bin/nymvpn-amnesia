#!/usr/bin/env bash
# Launch NymVPN GUI from the shared amnesia install.
set -euo pipefail
for c in \
  /opt/x47-amnesia/nym/NymVPN.AppImage \
  /opt/x47-amnesia/nym/nym-vpn-app \
  /usr/bin/nym-vpn-app \
  /usr/bin/nymvpn
do
  if [[ -x "$c" ]]; then
    exec "$c" "$@"
  fi
done
notify-send "NymVPN" "NymVPN is not installed. Re-run: ./install.sh --with-amnesia" 2>/dev/null || true
echo "NymVPN binary not found under /opt/x47-amnesia/nym/" >&2
exit 1
