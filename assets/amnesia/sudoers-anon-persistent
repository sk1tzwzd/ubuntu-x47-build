# Allow anon to manage ONLY the X47 amnesia helpers (no full sudo).
Cmnd_Alias X47_PERSISTENT = /usr/local/sbin/anon-persistent create, \
                            /usr/local/sbin/anon-persistent create *, \
                            /usr/local/sbin/anon-persistent unlock, \
                            /usr/local/sbin/anon-persistent lock, \
                            /usr/local/sbin/anon-persistent status
Cmnd_Alias X47_MAC = /usr/local/sbin/anon-mac-spoof apply, \
                     /usr/local/sbin/anon-mac-spoof restore, \
                     /usr/local/sbin/anon-mac-spoof boot-cleanup, \
                     /usr/local/sbin/anon-mac-spoof status

anon ALL=(root) NOPASSWD:SETENV: X47_PERSISTENT, X47_MAC
Defaults!X47_PERSISTENT env_keep += "DISPLAY WAYLAND_DISPLAY XAUTHORITY X47_PERSISTENT_PASSPHRASE"
