#!/usr/bin/env bash
# Apply X47 Visual or Performance desktop mode.
#
# Usage:
#   x47-desktop-mode                # show current
#   x47-desktop-mode status
#   x47-desktop-mode visual
#   x47-desktop-mode performance
#   x47-desktop-mode sync-power     # optional: map powerprofilesctl → mode (both only)
set -euo pipefail

HERE="$(cd "$(dirname "$(readlink -f "${BASH_SOURCE[0]}" 2>/dev/null || realpath "${BASH_SOURCE[0]}" 2>/dev/null || echo "${BASH_SOURCE[0]}")")" && pwd)"

X47_LIB=""
if [[ -f "$HERE/../lib/settings.sh" ]]; then
  X47_LIB="$(cd "$HERE/../lib" && pwd)"
elif [[ -f "$HOME/.local/share/ubuntu-x47-build/lib/settings.sh" ]]; then
  X47_LIB="$HOME/.local/share/ubuntu-x47-build/lib"
fi
[[ -n "$X47_LIB" ]] || { echo "x47-desktop-mode: cannot find lib/" >&2; exit 1; }

# shellcheck disable=SC1091
. "$X47_LIB/common.sh"
# shellcheck disable=SC1091
. "$X47_LIB/settings.sh"
# shellcheck disable=SC1091
. "$X47_LIB/desktop-mode.sh"

_notify() {
  local title="$1" body="$2"
  if have notify-send; then
    notify-send -a 'X47 Desktop' "$title" "$body" 2>/dev/null || true
  fi
  log "$title — $body"
}

_ext_enable() {
  local uuid="$1" cur cleaned
  # System docks live under /usr/share; user extensions under ~/.local.
  if [[ ! -d "$HOME/.local/share/gnome-shell/extensions/$uuid" ]] \
     && [[ ! -d "/usr/share/gnome-shell/extensions/$uuid" ]] \
     && ! gnome-extensions info "$uuid" >/dev/null 2>&1; then
    return 0
  fi
  # Clear disabled-extensions or Ubuntu Dock stays suppressed after Visual apply.
  cur="$(gsettings get org.gnome.shell disabled-extensions 2>/dev/null || echo "@as []")"
  if [[ "$cur" == *"'$uuid'"* ]]; then
    cleaned="$(printf '%s' "$cur" | sed -E "s/'$uuid',? ?//g; s/, ]/]/g; s/\[,/[/g; s/\[ ,/[/g")"
    gsettings set org.gnome.shell disabled-extensions "$cleaned" 2>/dev/null || true
  fi
  gnome-extensions enable "$uuid" 2>/dev/null || true
  cur="$(gsettings get org.gnome.shell enabled-extensions 2>/dev/null || echo "@as []")"
  if [[ "$cur" != *"'$uuid'"* ]]; then
    if [[ "$cur" == "@as []" || "$cur" == "[]" ]]; then
      gsettings set org.gnome.shell enabled-extensions "['$uuid']" 2>/dev/null || true
    else
      gsettings set org.gnome.shell enabled-extensions "${cur%]}, '$uuid']" 2>/dev/null || true
    fi
  fi
}

_ext_disable() {
  local uuid="$1"
  gnome-extensions disable "$uuid" 2>/dev/null || true
  local cur cleaned
  cur="$(gsettings get org.gnome.shell enabled-extensions 2>/dev/null || echo "@as []")"
  cleaned="$(printf '%s' "$cur" | sed -E "s/'$uuid',? ?//g; s/, ]/]/g; s/\[,/[/g")"
  gsettings set org.gnome.shell enabled-extensions "$cleaned" 2>/dev/null || true
  cur="$(gsettings get org.gnome.shell disabled-extensions 2>/dev/null || echo "@as []")"
  if [[ "$cur" != *"'$uuid'"* ]]; then
    if [[ "$cur" == "@as []" || "$cur" == "[]" ]]; then
      gsettings set org.gnome.shell disabled-extensions "['$uuid']" 2>/dev/null || true
    else
      gsettings set org.gnome.shell disabled-extensions "${cur%]}, '$uuid']" 2>/dev/null || true
    fi
  fi
}

_hide_dock() {
  # Ubuntu session mode lists ubuntu-dock in enabledExtensions — disabling it
  # fights the session (ERROR state) and the dock often comes back. Hide via
  # dash-to-dock settings instead; only disable optional user dash-to-dock.
  gsettings set org.gnome.shell.extensions.dash-to-dock manualhide true 2>/dev/null || true
  gsettings set org.gnome.shell.extensions.dash-to-dock dock-fixed false 2>/dev/null || true
  gsettings set org.gnome.shell.extensions.dash-to-dock autohide true 2>/dev/null || true
  gsettings set org.gnome.shell.extensions.dash-to-dock intellihide false 2>/dev/null || true
  # Keep system dock enabled (session-owned); strip any accidental disable flag.
  if gnome-extensions info ubuntu-dock@ubuntu.com >/dev/null 2>&1 \
     || [[ -d /usr/share/gnome-shell/extensions/ubuntu-dock@ubuntu.com ]]; then
    _ext_enable ubuntu-dock@ubuntu.com
  fi
  if [[ -d "$HOME/.local/share/gnome-shell/extensions/dash-to-dock@micxgx.gmail.com" ]]; then
    _ext_disable dash-to-dock@micxgx.gmail.com
  fi
}

_show_dock() {
  # Prefer Ubuntu's dock; fall back to dash-to-dock if present.
  if [[ -d "$HOME/.local/share/gnome-shell/extensions/ubuntu-dock@ubuntu.com" ]] \
     || gnome-extensions info ubuntu-dock@ubuntu.com >/dev/null 2>&1 \
     || [[ -d /usr/share/gnome-shell/extensions/ubuntu-dock@ubuntu.com ]]; then
    _ext_enable ubuntu-dock@ubuntu.com
  fi
  if [[ -d "$HOME/.local/share/gnome-shell/extensions/dash-to-dock@micxgx.gmail.com" ]]; then
    _ext_enable dash-to-dock@micxgx.gmail.com
  fi
  # Reveal dock for Visual (manualhide is how Performance keeps it gone).
  gsettings set org.gnome.shell.extensions.dash-to-dock manualhide false 2>/dev/null || true
  gsettings set org.gnome.shell.extensions.dash-to-dock dock-fixed true 2>/dev/null || true
  gsettings set org.gnome.shell.extensions.dash-to-dock intellihide false 2>/dev/null || true
  gsettings set org.gnome.shell.extensions.dash-to-dock autohide false 2>/dev/null || true
  gsettings set org.gnome.shell.extensions.dash-to-dock multi-monitor true 2>/dev/null || true
  gsettings set org.gnome.shell.extensions.dash-to-dock dock-position 'BOTTOM' 2>/dev/null || true
  gsettings set org.gnome.shell.extensions.dash-to-dock click-action 'cycle-windows' 2>/dev/null || true
}

_apply_performance() {
  local uuid
  for uuid in "${X47_HEAVY_FX_UUIDS[@]}"; do
    _ext_disable "$uuid"
  done
  for uuid in "${X47_WINDOW_FX_UUIDS[@]}"; do
    _ext_disable "$uuid"
  done
  for uuid in "${X47_LEAN_FX_UUIDS[@]}"; do
    _ext_enable "$uuid"
  done
  _hide_dock
  gsettings set org.gnome.desktop.interface enable-animations false 2>/dev/null || true
  gsettings set org.gnome.mutter dynamic-workspaces false 2>/dev/null || true
  gsettings set org.gnome.desktop.wm.preferences num-workspaces 4 2>/dev/null || true
  x47_settings_set_str desktop_mode performance
}

_apply_visual() {
  local uuid installed
  installed="$(x47_settings_get_str desktop_modes_installed both)"
  if [[ "$installed" == "performance" ]]; then
    warn "Visual stack was not installed (desktop_modes_installed=performance) — staying lean"
    _apply_performance
    return 0
  fi
  for uuid in "${X47_LEAN_FX_UUIDS[@]}"; do
    _ext_enable "$uuid"
  done
  for uuid in "${X47_HEAVY_FX_UUIDS[@]}"; do
    _ext_enable "$uuid"
  done
  # No wobble, no Burn My Windows open/close — even in Visual.
  for uuid in "${X47_WINDOW_FX_UUIDS[@]}"; do
    _ext_disable "$uuid"
  done
  # Dock stays off in both modes (Super / Show Apps for launching).
  _hide_dock
  gsettings set org.gnome.desktop.interface enable-animations true 2>/dev/null || true
  gsettings set org.gnome.mutter dynamic-workspaces false 2>/dev/null || true
  gsettings set org.gnome.desktop.wm.preferences num-workspaces 4 2>/dev/null || true
  x47_settings_set_str desktop_mode visual
}

cmd_status() {
  x47_settings_ensure
  local mode installed
  mode="$(x47_settings_get_str desktop_mode performance)"
  installed="$(x47_settings_get_str desktop_modes_installed both)"
  echo "desktop_mode=$mode"
  echo "desktop_modes_installed=$installed"
  if have powerprofilesctl; then
    echo "power_profile=$(powerprofilesctl get 2>/dev/null || echo unknown)"
  fi
  echo "animations=$(gsettings get org.gnome.desktop.interface enable-animations 2>/dev/null || echo '?')"
}

cmd_sync_power() {
  local installed mode want profile
  installed="$(x47_settings_get_str desktop_modes_installed both)"
  mode="$(x47_settings_get_str desktop_mode performance)"

  if [[ "$installed" == "performance" ]]; then
    [[ "$mode" == "performance" ]] || _apply_performance
    return 0
  fi
  if [[ "$installed" != "both" ]]; then
    return 0
  fi

  if ! have powerprofilesctl; then
    warn "powerprofilesctl missing — cannot sync Power Mode"
    return 0
  fi
  profile="$(powerprofilesctl get 2>/dev/null || echo balanced)"
  case "$profile" in
    performance) want=performance ;;
    *) want=visual ;;
  esac
  if [[ "$mode" == "$want" ]]; then
    return 0
  fi
  if [[ "$want" == "performance" ]]; then
    _apply_performance
    _notify 'Performance desktop' \
      'Cube and window FX off. Log out/in if effects still linger (Wayland).'
  else
    _apply_visual
    _notify 'Visual desktop' \
      'Full FX restored. Log out/in if extensions still look wrong (Wayland).'
  fi
}

usage() {
  cat <<'EOF'
X47 Desktop Mode — Visual vs Performance

  x47-desktop-mode                 Show status
  x47-desktop-mode status
  x47-desktop-mode visual          Cube, Coverflow, blur, multi-colour walls (no wobble / window open-close)
  x47-desktop-mode performance     Lean desktop (no heavy FX; dock off)
  x47-desktop-mode sync-power      Optional: apply from GNOME Power Mode (both)

Toggle from the top-bar chip (right side) when both modes are installed.
EOF
}

main() {
  local cmd="${1:-status}"
  case "$cmd" in
    ""|status) cmd_status ;;
    visual|v|full)
      _apply_visual
      _notify 'Visual desktop' 'Applied. Log out/in on Wayland if cube/blur did not load.'
      cmd_status
      ;;
    performance|perf|hp)
      _apply_performance
      _notify 'Performance desktop' 'Applied. Log out/in on Wayland if needed.'
      cmd_status
      ;;
    sync-power|sync) cmd_sync_power ;;
    -h|--help|help) usage ;;
    *) echo "unknown command: $cmd" >&2; usage; exit 2 ;;
  esac
}

main "$@"
