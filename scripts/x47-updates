#!/usr/bin/env bash
# X47 Updates & Clean — updates plus a CCleaner-style tidy pass.
#
# Usage:
#   x47-updates                 # GUI hub (updates / clean / both)
#   x47-updates gui
#   x47-updates check           # refresh indexes + print report
#   x47-updates apply           # apply all updates (password prompt)
#   x47-updates status          # last check summary
#   x47-updates repair-sources  # restore Mullvad (and similar) apt lists
#   x47-updates clean-scan      # preview reclaimable junk (no deletes)
#   x47-updates clean           # empty trash + default tidy set
#   x47-updates tidy            # scan then clean defaults
set -euo pipefail

export PATH="${HOME}/.local/bin:${PATH}"

STATUS_FILE="${X47_UPDATES_STATUS:-$HOME/.config/x47/updates-status.conf}"
REPORT_FILE="${X47_UPDATES_REPORT:-$HOME/.cache/x47/updates-report.txt}"
CLEAN_STATUS="${X47_CLEAN_STATUS:-$HOME/.config/x47/clean-status.conf}"
CLEAN_REPORT="${X47_CLEAN_REPORT:-$HOME/.cache/x47/clean-report.txt}"
CLEAN_SIZES="${X47_CLEAN_SIZES:-$HOME/.cache/x47/clean-sizes.conf}"

_usage() {
  cat <<'EOF'
X47 Updates & Clean — updates plus a tidy pass (CCleaner-style)

  x47-updates                 Open GUI hub
  x47-updates gui             Force Zenity hub
  x47-updates check           Refresh indexes and list pending updates
  x47-updates apply           Apply apt + snap + Cursor + VS Code + Claude Code extension
  x47-updates status          Show last check / clean summary
  x47-updates repair-sources  Restore missing third-party apt sources (Mullvad)
  x47-updates clean-scan      Preview reclaimable junk (nothing deleted)
  x47-updates clean           Apply default tidy set (or named categories)
  x47-updates tidy            Scan, then clean the default set

Updates: apt, snap, Cursor, VS Code, Claude Code VS Code extension (no standalone CLI).
Default clean (safe): trash, thumbnails, apt cache, leftover packages,
old snap revisions, journals (keep 7 days), crash reports, pip/npm caches.

Optional: browser-cache, recently-used, tracker
Never: Documents, Pictures, Desktop, Downloads, passwords, cookies, ~/.config
EOF
}

_have() { command -v "$1" >/dev/null 2>&1; }

_ensure_dirs() {
  mkdir -p "$(dirname "$STATUS_FILE")" "$(dirname "$REPORT_FILE")" \
    "$(dirname "$CLEAN_STATUS")" "$(dirname "$CLEAN_REPORT")" "$(dirname "$CLEAN_SIZES")"
}

_status_set() {
  local key="$1" val="$2"
  _ensure_dirs
  touch "$STATUS_FILE"
  if grep -qE "^${key}=" "$STATUS_FILE" 2>/dev/null; then
    sed -i "s|^${key}=.*|${key}=${val}|" "$STATUS_FILE"
  else
    printf '%s=%s\n' "$key" "$val" >>"$STATUS_FILE"
  fi
}

_status_get() {
  local key="$1" def="${2:-}"
  [[ -f "$STATUS_FILE" ]] || { printf '%s' "$def"; return 0; }
  local line
  line="$(grep -E "^${key}=" "$STATUS_FILE" 2>/dev/null | tail -n1 || true)"
  if [[ -n "$line" ]]; then
    printf '%s' "${line#*=}"
  else
    printf '%s' "$def"
  fi
}

# Run a privileged command: prefer pkexec for GUI, else sudo.
_priv() {
  if [[ "$(id -u)" -eq 0 ]]; then
    env "$@"
    return
  fi
  if [[ -n "${DISPLAY:-}${WAYLAND_DISPLAY:-}" ]] && _have pkexec; then
    pkexec env "$@"
    return
  fi
  if _have sudo; then
    sudo env "$@"
    return
  fi
  echo "sudo or pkexec required" >&2
  return 1
}

_mullvad_source_missing() {
  dpkg -s mullvad-vpn >/dev/null 2>&1 || return 1
  [[ ! -f /etc/apt/sources.list.d/mullvad.list ]] && return 0
  # Treat unknown suite (e.g. resolute before Mullvad publishes it) as needing repair.
  local suite
  suite="$(awk '/^deb / {
    for (i=1;i<=NF;i++) if ($i ~ /^https?:/) { print $(i+1); exit }
  }' /etc/apt/sources.list.d/mullvad.list 2>/dev/null || true)"
  [[ -z "$suite" ]] && return 0
  ! curl -fsSIL "https://repository.mullvad.net/deb/stable/dists/${suite}/Release" >/dev/null 2>&1
}

_mullvad_suite() {
  local host="${1:-}"
  [[ -n "$host" ]] || host="$(. /etc/os-release; echo "${VERSION_CODENAME:-noble}")"
  if curl -fsSIL "https://repository.mullvad.net/deb/stable/dists/${host}/Release" >/dev/null 2>&1; then
    printf '%s' "$host"
  else
    printf 'noble'
  fi
}

_repair_mullvad_source() {
  local host_codename codename arch_name key_tmp list_tmp
  host_codename="$(. /etc/os-release; echo "${VERSION_CODENAME:-noble}")"
  codename="$(_mullvad_suite "$host_codename")"
  arch_name="$(dpkg --print-architecture 2>/dev/null || echo amd64)"
  key_tmp="$(mktemp)"
  list_tmp="$(mktemp)"
  echo "Restoring Mullvad apt repository…"
  if [[ "$codename" != "$host_codename" ]]; then
    echo "note: Mullvad has no ${host_codename} suite yet — using ${codename}"
  fi
  curl -fsSL https://repository.mullvad.net/deb/mullvad-keyring.asc -o "$key_tmp"
  printf 'deb [signed-by=/usr/share/keyrings/mullvad-keyring.asc arch=%s] https://repository.mullvad.net/deb/stable %s main\n' \
    "$arch_name" "$codename" >"$list_tmp"
  # Install via privileged helper so pkexec/sudo only copy local files.
  _priv bash -c "
    set -euo pipefail
    install -m 0755 -d /usr/share/keyrings /etc/apt/sources.list.d
    install -m 0644 '$key_tmp' /usr/share/keyrings/mullvad-keyring.asc
    install -m 0644 '$list_tmp' /etc/apt/sources.list.d/mullvad.list
    apt-get update -qq
  "
  local rc=$?
  rm -f "$key_tmp" "$list_tmp"
  return "$rc"
}

cmd_repair_sources() {
  if ! dpkg -s mullvad-vpn >/dev/null 2>&1; then
    echo "mullvad_source=not_installed"
    echo "No missing third-party sources to repair."
    return 0
  fi
  if ! _mullvad_source_missing; then
    echo "mullvad_source=ok"
    echo "No missing third-party sources to repair."
    return 0
  fi
  if _repair_mullvad_source; then
    echo "mullvad_source=restored"
  else
    echo "mullvad_source=repair_failed" >&2
    return 1
  fi
}

_cursor_bin() {
  if [[ -x "$HOME/.local/bin/update-cursor" ]]; then
    printf '%s' "$HOME/.local/bin/update-cursor"
  elif _have update-cursor; then
    command -v update-cursor
  else
    return 1
  fi
}

_apt_upgradable_list() {
  # apt list needs indexes; do not fail hard if apt is locked briefly.
  apt list --upgradable 2>/dev/null | awk -F/ 'NR>1 {print $1}' | sed '/^$/d' || true
}

_snap_refresh_list() {
  if ! _have snap; then
    return 0
  fi
  # "All snaps up to date." or lines of snaps
  snap refresh --list 2>/dev/null | awk 'NR>1 && $1!="" {print $1}' || true
}

_write_report() {
  local apt_n="$1" snap_n="$2" cursor_note="$3" vscode_note="$4" claude_note="$5" mullvad_note="$6" reboot_note="$7"
  local apt_list="$8" snap_list="$9"
  _ensure_dirs
  {
    echo "X47 Updates report — $(date -Is)"
    echo
    echo "=== apt ($apt_n) ==="
    if [[ "$apt_n" -eq 0 ]]; then
      echo "(none)"
    else
      printf '%s\n' "$apt_list"
    fi
    echo
    echo "=== snap ($snap_n) ==="
    if [[ "$snap_n" -eq 0 ]]; then
      echo "(none)"
    else
      printf '%s\n' "$snap_list"
    fi
    echo
    echo "=== Cursor ==="
    echo "$cursor_note"
    echo
    echo "=== VS Code ==="
    echo "$vscode_note"
    echo
    echo "=== Claude Code ==="
    echo "$claude_note"
    echo
    echo "=== Mullvad apt source ==="
    echo "$mullvad_note"
    echo
    echo "=== Reboot ==="
    echo "$reboot_note"
  } >"$REPORT_FILE"
}

_claude_cli_ver() {
  claude --version 2>/dev/null | grep -oE '[0-9]+\.[0-9]+\.[0-9]+' | head -1 || true
}

_claude_ext_ver() {
  local d
  d="$(ls -d "$HOME/.vscode/extensions"/anthropic.claude-code-* 2>/dev/null | sort -V | tail -1 || true)"
  [[ -n "$d" ]] || return 0
  basename "$d" | grep -oE '[0-9]+\.[0-9]+\.[0-9]+' | head -1 || true
}

_apt_candidate() {
  local pkg="$1"
  apt-cache policy "$pkg" 2>/dev/null | awk '/Candidate:/{print $2; exit}'
}

_apt_installed_ver() {
  dpkg-query -W -f='${Version}' "$1" 2>/dev/null || true
}

_harden_code_desktop() {
  local sys dest prefix
  prefix="env PATH=${HOME}/.local/bin:/usr/local/bin:/usr/bin:/bin ELECTRON_OZONE_PLATFORM_HINT=x11 "
  mkdir -p "$HOME/.local/share/applications"
  for name in code.desktop code-url-handler.desktop; do
    sys="/usr/share/applications/${name}"
    dest="$HOME/.local/share/applications/${name}"
    [[ -f "$sys" ]] || continue
    install -m 0644 "$sys" "$dest"
    sed -i "s|^Exec=|Exec=${prefix}|" "$dest"
  done
  if _have update-desktop-database; then
    update-desktop-database "$HOME/.local/share/applications" >/dev/null 2>&1 || true
  fi
  if _have xdg-mime && [[ -f "$HOME/.local/share/applications/code-url-handler.desktop" ]]; then
    xdg-mime default code-url-handler.desktop x-scheme-handler/vscode 2>/dev/null || true
  fi
}

_update_claude_and_vscode_ext() {
  echo "--- Claude Code CLI (removed; VS Code extension only) ---"
  rm -f "$HOME/.local/bin/claude"
  rm -rf "$HOME/.local/share/claude/versions"
  rm -f "$HOME/.local/share/applications/launcher-claude.desktop"
  echo "--- VS Code Claude Code extension ---"
  if _have code; then
    code --install-extension anthropic.claude-code --force || echo "warn: extension install failed" >&2
  else
    echo "VS Code (code) not installed — skip extension"
  fi
  _harden_code_desktop
}

cmd_check() {
  local apt_list snap_list apt_n snap_n cursor_note vscode_note claude_note mullvad_note reboot_note
  local claude_pending=0 vscode_pending=0
  echo "Checking for updates…"

  if _mullvad_source_missing; then
    echo "Mullvad apt source missing — restoring so updates can be found…"
    _repair_mullvad_source || echo "warn: could not restore Mullvad source" >&2
  fi

  echo "Refreshing apt indexes…"
  if ! _priv apt-get update -qq; then
    echo "warn: apt update failed (password cancelled or network?)" >&2
  fi

  apt_list="$(_apt_upgradable_list)"
  if [[ -z "${apt_list// }" ]]; then
    apt_n=0
    apt_list=""
  else
    apt_n="$(printf '%s\n' "$apt_list" | grep -c . || true)"
  fi

  snap_list="$(_snap_refresh_list)"
  if [[ -z "${snap_list// }" ]]; then
    snap_n=0
    snap_list=""
  else
    snap_n="$(printf '%s\n' "$snap_list" | grep -c . || true)"
  fi

  if dpkg -s cursor >/dev/null 2>&1; then
    cursor_note="installed $(dpkg-query -W -f='${Version}' cursor 2>/dev/null || echo '?') — will only-upgrade on Apply"
  else
    cursor_note="not installed"
  fi

  if dpkg -s code >/dev/null 2>&1; then
    local code_have code_cand
    code_have="$(_apt_installed_ver code)"
    code_cand="$(_apt_candidate code)"
    if [[ -n "$code_cand" && "$code_cand" != "$code_have" && "$code_cand" != "(none)" ]]; then
      vscode_note="installed ${code_have} → ${code_cand} available — will only-upgrade on Apply"
      vscode_pending=1
    else
      vscode_note="installed ${code_have} (up to date)"
    fi
  else
    vscode_note="not installed"
  fi

  local cli_v ext_v
  cli_v=""
  ext_v="$(_claude_ext_ver)"
  if [[ -n "$ext_v" ]]; then
    claude_note="VS Code extension ${ext_v} (CLI not used)"
  else
    claude_note="VS Code extension missing — Apply will install anthropic.claude-code"
    claude_pending=1
  fi

  if dpkg -s mullvad-vpn >/dev/null 2>&1; then
    if [[ -f /etc/apt/sources.list.d/mullvad.list ]]; then
      mullvad_note="ok ($(dpkg-query -W -f='${Version}' mullvad-vpn 2>/dev/null))"
    else
      mullvad_note="MISSING source list (run: x47-updates repair-sources)"
    fi
  else
    mullvad_note="not installed"
  fi

  if [[ -f /var/run/reboot-required ]]; then
    reboot_note="YES — reboot recommended after updates"
  else
    reboot_note="no"
  fi

  _write_report "$apt_n" "$snap_n" "$cursor_note" "$vscode_note" "$claude_note" "$mullvad_note" "$reboot_note" "$apt_list" "$snap_list"
  _status_set last_check "$(date -Is)"
  _status_set apt_count "$apt_n"
  _status_set snap_count "$snap_n"
  _status_set claude_pending "$claude_pending"
  _status_set vscode_pending "$vscode_pending"
  _status_set reboot_required "$([[ -f /var/run/reboot-required ]] && echo 1 || echo 0)"

  cat "$REPORT_FILE"
  echo
  echo "report=$REPORT_FILE"
  local total=$((apt_n + snap_n + claude_pending))
  echo "pending_total=${total}"
}

cmd_status() {
  if [[ ! -f "$STATUS_FILE" ]]; then
    echo "No update check yet. Run: x47-updates check"
  else
    echo "last_check=$(_status_get last_check never)"
    echo "apt_count=$(_status_get apt_count 0)"
    echo "snap_count=$(_status_get snap_count 0)"
    echo "reboot_required=$(_status_get reboot_required 0)"
    [[ -f "$REPORT_FILE" ]] && echo "report=$REPORT_FILE"
  fi
  if [[ -f "$CLEAN_STATUS" ]]; then
    echo "last_clean_scan=$(_kv_get "$CLEAN_STATUS" last_scan never)"
    echo "last_clean=$(_kv_get "$CLEAN_STATUS" last_clean never)"
    echo "last_reclaimed=$(_kv_get "$CLEAN_STATUS" last_reclaimed 0)"
    [[ -f "$CLEAN_REPORT" ]] && echo "clean_report=$CLEAN_REPORT"
  fi
}

_kv_set() {
  local file="$1" key="$2" val="$3"
  mkdir -p "$(dirname "$file")"
  touch "$file"
  if grep -qE "^${key}=" "$file" 2>/dev/null; then
    sed -i "s|^${key}=.*|${key}=${val}|" "$file"
  else
    printf '%s=%s\n' "$key" "$val" >>"$file"
  fi
}

_kv_get() {
  local file="$1" key="$2" def="${3:-}"
  [[ -f "$file" ]] || { printf '%s' "$def"; return 0; }
  local line
  line="$(grep -E "^${key}=" "$file" 2>/dev/null | tail -n1 || true)"
  if [[ -n "$line" ]]; then
    printf '%s' "${line#*=}"
  else
    printf '%s' "$def"
  fi
}

_bytes_human() {
  local b="${1:-0}"
  awk -v b="$b" 'BEGIN {
    if (b < 1024) printf "%d B", b
    else if (b < 1048576) printf "%.1f KB", b/1024
    else if (b < 1073741824) printf "%.1f MB", b/1048576
    else printf "%.2f GB", b/1073741824
  }'
}

_path_bytes() {
  local total=0 p n
  for p in "$@"; do
    [[ -n "$p" && -e "$p" ]] || continue
    n="$(du -sb "$p" 2>/dev/null | awk '{print $1}')"
    [[ "$n" =~ ^[0-9]+$ ]] || n=0
    total=$((total + n))
  done
  printf '%s' "$total"
}

_clean_default_keys() {
  printf '%s\n' trash thumbnails apt_cache apt_autoremove snap_old journals crash dev_caches
}

_trash_paths() {
  printf '%s\n' \
    "$HOME/.local/share/Trash" \
    "$HOME/.Trash"
}

_thumb_paths() {
  printf '%s\n' \
    "$HOME/.cache/thumbnails" \
    "$HOME/.thumbnails"
}

_browser_cache_paths() {
  printf '%s\n' \
    "$HOME/.cache/mozilla/firefox" \
    "$HOME/.cache/google-chrome" \
    "$HOME/.cache/chromium" \
    "$HOME/.cache/BraveSoftware" \
    "$HOME/.cache/microsoft-edge" \
    "$HOME/.var/app/org.mozilla.firefox/cache" \
    "$HOME/.var/app/com.google.Chrome/cache" \
    "$HOME/.var/app/com.brave.Browser/cache"
}

_dev_cache_paths() {
  printf '%s\n' \
    "$HOME/.cache/pip" \
    "$HOME/.cache/pipx" \
    "$HOME/.npm/_cacache" \
    "$HOME/.cache/yarn" \
    "$HOME/.cache/pnpm" \
    "$HOME/.cache/fontconfig" \
    "$HOME/.cache/mesa_shader_cache" \
    "$HOME/.cache/mesa_shader_cache_db"
}

_tracker_paths() {
  printf '%s\n' \
    "$HOME/.cache/tracker3" \
    "$HOME/.cache/tracker" \
    "$HOME/.cache/localsearch"
}

_snap_old_revs() {
  _have snap || return 0
  snap list --all 2>/dev/null | awk '/disabled/{print $1, $3}' || true
}

_apt_autoremove_names() {
  apt-get -s autoremove --purge 2>/dev/null \
    | awk '/^Remv /{print $2}' || true
}

cmd_clean_scan() {
  _ensure_dirs
  local trash_b thumb_b apt_b auto_n snap_n journal_b crash_b dev_b br_b track_b rec_b
  local auto_list snap_list
  echo "Scanning junk (nothing will be deleted)…"

  local -a paths
  mapfile -t paths < <(_trash_paths)
  trash_b="$(_path_bytes "${paths[@]:-}")"
  mapfile -t paths < <(_thumb_paths)
  thumb_b="$(_path_bytes "${paths[@]:-}")"
  apt_b="$(_path_bytes /var/cache/apt/archives)"
  auto_list="$(_apt_autoremove_names)"
  if [[ -z "${auto_list// }" ]]; then auto_n=0; else auto_n="$(printf '%s\n' "$auto_list" | grep -c . || true)"; fi
  snap_list="$(_snap_old_revs)"
  if [[ -z "${snap_list// }" ]]; then snap_n=0; else snap_n="$(printf '%s\n' "$snap_list" | grep -c . || true)"; fi
  journal_b=0
  if _have journalctl; then
    journal_b="$(journalctl --disk-usage 2>/dev/null | grep -oE '[0-9.]+[KMGTP]B?' | head -1 || true)"
  fi
  crash_b="$(_path_bytes /var/crash /var/lib/systemd/coredump)"
  mapfile -t paths < <(_dev_cache_paths)
  dev_b="$(_path_bytes "${paths[@]:-}")"
  mapfile -t paths < <(_browser_cache_paths)
  br_b="$(_path_bytes "${paths[@]:-}")"
  mapfile -t paths < <(_tracker_paths)
  track_b="$(_path_bytes "${paths[@]:-}")"
  rec_b=0
  [[ -f "$HOME/.local/share/recently-used.xbel" ]] && rec_b="$(_path_bytes "$HOME/.local/share/recently-used.xbel")"

  : >"$CLEAN_SIZES"
  _kv_set "$CLEAN_SIZES" trash "$trash_b"
  _kv_set "$CLEAN_SIZES" thumbnails "$thumb_b"
  _kv_set "$CLEAN_SIZES" apt_cache "$apt_b"
  _kv_set "$CLEAN_SIZES" apt_autoremove_n "$auto_n"
  _kv_set "$CLEAN_SIZES" snap_old_n "$snap_n"
  _kv_set "$CLEAN_SIZES" crash "$crash_b"
  _kv_set "$CLEAN_SIZES" dev_caches "$dev_b"
  _kv_set "$CLEAN_SIZES" browser_cache "$br_b"
  _kv_set "$CLEAN_SIZES" tracker "$track_b"
  _kv_set "$CLEAN_SIZES" recently_used "$rec_b"
  _kv_set "$CLEAN_SIZES" journals_note "${journal_b:-unknown}"

  local default_b=$((trash_b + thumb_b + apt_b + crash_b + dev_b))
  {
    echo "X47 Clean scan — $(date -Is)"
    echo
    echo "Safe defaults (will run with: x47-updates clean)"
    echo "  Trash / recycle bin     $(_bytes_human "$trash_b")"
    echo "  Thumbnail cache         $(_bytes_human "$thumb_b")"
    echo "  Apt download cache      $(_bytes_human "$apt_b")"
    echo "  Leftover packages       ${auto_n} (apt autoremove --purge)"
    if [[ "$auto_n" -gt 0 ]]; then
      printf '%s\n' "$auto_list" | sed 's/^/    /'
    fi
    echo "  Old snap revisions      ${snap_n}"
    if [[ "$snap_n" -gt 0 ]]; then
      printf '%s\n' "$snap_list" | sed 's/^/    /'
    fi
    echo "  Journal logs            ${journal_b:-?} (vacuum to last 7 days)"
    echo "  Crash / coredumps       $(_bytes_human "$crash_b")"
    echo "  pip/npm/font/GPU cache  $(_bytes_human "$dev_b")"
    echo
    echo "Optional (off unless you ask)"
    echo "  Browser caches only     $(_bytes_human "$br_b")  (not history/cookies)"
    echo "  Tracker / localsearch   $(_bytes_human "$track_b")"
    echo "  Recent-files list       $(_bytes_human "$rec_b")"
    echo
    echo "Never touched: Documents, Pictures, Desktop, Downloads,"
    echo "passwords, cookies, browser profiles, ~/.config, SSH/GPG keys."
    echo
    echo "default_reclaim_est=$(_bytes_human "$default_b") + leftover packages + journals + snaps"
  } >"$CLEAN_REPORT"

  _kv_set "$CLEAN_STATUS" last_scan "$(date -Is)"
  _kv_set "$CLEAN_STATUS" default_bytes "$default_b"
  cat "$CLEAN_REPORT"
}

_rm_tree_contents() {
  local root="$1"
  [[ -d "$root" ]] || return 0
  find "$root" -mindepth 1 -maxdepth 1 -exec rm -rf {} + 2>/dev/null || true
}

_clean_user_items() {
  local key
  for key in "$@"; do
    case "$key" in
      trash)
        echo "--- empty recycle bin ---"
        if _have gio; then
          gio trash --empty 2>/dev/null || true
        fi
        local p
        while IFS= read -r p; do
          _rm_tree_contents "$p"
        done < <(_trash_paths)
        ;;
      thumbnails)
        echo "--- thumbnail cache ---"
        while IFS= read -r p; do
          _rm_tree_contents "$p"
        done < <(_thumb_paths)
        ;;
      dev_caches)
        echo "--- pip / npm / font / GPU caches ---"
        while IFS= read -r p; do
          rm -rf "$p" 2>/dev/null || true
        done < <(_dev_cache_paths)
        ;;
      browser_cache)
        echo "--- browser caches (not profiles / cookies) ---"
        while IFS= read -r p; do
          rm -rf "$p" 2>/dev/null || true
        done < <(_browser_cache_paths)
        ;;
      tracker)
        echo "--- tracker / localsearch cache ---"
        while IFS= read -r p; do
          rm -rf "$p" 2>/dev/null || true
        done < <(_tracker_paths)
        ;;
      recently_used)
        echo "--- recent-files list ---"
        rm -f "$HOME/.local/share/recently-used.xbel" 2>/dev/null || true
        ;;
    esac
  done
}

_clean_priv_script() {
  # Emitted for pkexec/sudo: system-level tidy only.
  cat <<'EOS'
#!/usr/bin/env bash
set -euo pipefail
export DEBIAN_FRONTEND=noninteractive
ITEMS="$*"
contains() { [[ " $ITEMS " == *" $1 "* ]]; }

if contains apt_cache; then
  echo "--- apt clean / autoclean ---"
  apt-get clean || true
  apt-get autoclean -y || true
fi
if contains apt_autoremove; then
  echo "--- apt autoremove --purge ---"
  apt-get autoremove --purge -y || true
fi
if contains journals; then
  echo "--- journal vacuum (7 days) ---"
  journalctl --vacuum-time=7d || true
  find /var/log -type f \( -name '*.gz' -o -name '*.old' -o -name '*.1' \) -delete 2>/dev/null || true
fi
if contains crash; then
  echo "--- crash reports / coredumps ---"
  rm -f /var/crash/* 2>/dev/null || true
  rm -rf /var/lib/systemd/coredump/* 2>/dev/null || true
fi
if contains snap_old && command -v snap >/dev/null 2>&1; then
  echo "--- old snap revisions ---"
  snap list --all 2>/dev/null | awk '/disabled/{print $1, $3}' | while read -r name rev; do
    [[ -n "$name" && -n "$rev" ]] || continue
    echo "removing $name revision $rev"
    snap remove "$name" --revision="$rev" || true
  done
fi
if contains trash; then
  echo "--- root recycle bin ---"
  rm -rf /root/.local/share/Trash/files/* /root/.local/share/Trash/info/* 2>/dev/null || true
fi
if command -v flatpak >/dev/null 2>&1 && contains apt_autoremove; then
  echo "--- flatpak unused ---"
  flatpak uninstall --unused -y 2>/dev/null || true
fi
echo "--- privileged tidy done ---"
EOS
}

cmd_clean() {
  local yes=0
  local -a items=()
  while [[ $# -gt 0 ]]; do
    case "$1" in
      --yes|-y) yes=1; shift ;;
      --help|-h)
        echo "x47-updates clean [--yes] [trash thumbnails apt_cache apt_autoremove snap_old journals crash dev_caches browser_cache tracker recently_used]"
        return 0
        ;;
      *) items+=("$1"); shift ;;
    esac
  done
  if [[ ${#items[@]} -eq 0 ]]; then
    mapfile -t items < <(_clean_default_keys)
  fi

  if [[ "$yes" -ne 1 ]]; then
    echo "Will clean: ${items[*]}"
    echo "Never touches Documents / Pictures / Desktop / Downloads / passwords."
    read -r -p "Continue? [y/N] " ans || ans=n
    case "${ans,,}" in
      y|yes) ;;
      *) echo "Cancelled."; return 0 ;;
    esac
  fi

  echo "=== X47 Clean ==="
  _clean_user_items "${items[@]}"

  local need_priv=0 k
  for k in "${items[@]}"; do
    case "$k" in
      apt_cache|apt_autoremove|journals|crash|snap_old|trash) need_priv=1 ;;
    esac
  done

  if [[ "$need_priv" -eq 1 ]]; then
    local tmp
    tmp="$(mktemp /tmp/x47-clean-priv.XXXXXX.sh)"
    _clean_priv_script >"$tmp"
    chmod 0755 "$tmp"
    local rc=0
    echo "System tidy (password may be required)…"
    if [[ "$(id -u)" -eq 0 ]]; then
      bash "$tmp" "${items[*]}" || rc=$?
    elif [[ -n "${DISPLAY:-}${WAYLAND_DISPLAY:-}" ]] && _have pkexec; then
      pkexec bash "$tmp" "${items[*]}" || rc=$?
    elif _have sudo; then
      sudo bash "$tmp" "${items[*]}" || rc=$?
    else
      echo "warn: sudo/pkexec missing — skipped apt/journal/snap/crash" >&2
    fi
    rm -f "$tmp"
    [[ "$rc" -eq 0 ]] || echo "warn: privileged tidy exited $rc" >&2
  fi

  _kv_set "$CLEAN_STATUS" last_clean "$(date -Is)"
  echo
  echo "DONE — recycle bin emptied (if selected). Documents were not touched."
}

cmd_tidy() {
  cmd_clean_scan
  echo
  cmd_clean --yes
}

cmd_clean_gui() {
  if ! _have zenity; then
    cmd_tidy
    return 0
  fi
  zenity --info --title='X47 Clean' --width=440 \
    --text='Scan first. Nothing is deleted until you confirm.\nDocuments, Pictures, Desktop, Downloads, passwords, and cookies stay.' \
    2>/dev/null || true

  local scan_out
  if ! scan_out="$(cmd_clean_scan 2>&1)"; then
    zenity --error --title='X47 Clean' --width=480 \
      --text="Scan failed:\n\n$(printf '%s' "$scan_out" | tail -c 1200)" 2>/dev/null || true
    return 1
  fi

  local trash_b thumb_b apt_b auto_n snap_n crash_b dev_b br_b track_b rec_b jn
  trash_b="$(_kv_get "$CLEAN_SIZES" trash 0)"
  thumb_b="$(_kv_get "$CLEAN_SIZES" thumbnails 0)"
  apt_b="$(_kv_get "$CLEAN_SIZES" apt_cache 0)"
  auto_n="$(_kv_get "$CLEAN_SIZES" apt_autoremove_n 0)"
  snap_n="$(_kv_get "$CLEAN_SIZES" snap_old_n 0)"
  crash_b="$(_kv_get "$CLEAN_SIZES" crash 0)"
  dev_b="$(_kv_get "$CLEAN_SIZES" dev_caches 0)"
  br_b="$(_kv_get "$CLEAN_SIZES" browser_cache 0)"
  track_b="$(_kv_get "$CLEAN_SIZES" tracker 0)"
  rec_b="$(_kv_get "$CLEAN_SIZES" recently_used 0)"
  jn="$(_kv_get "$CLEAN_SIZES" journals_note '?')"

  local picked
  picked="$(zenity --list --checklist --title='X47 Clean' --width=620 --height=520 \
    --text='Tick what to remove. Safe defaults are on. Browser cache is off (history/cookies stay either way).' \
    --column=On --column=Id --column=What \
    --hide-column=2 --print-column=2 --separator=' ' \
    TRUE trash "Recycle bin / trash ($(_bytes_human "$trash_b"))" \
    TRUE thumbnails "Thumbnail cache ($(_bytes_human "$thumb_b"))" \
    TRUE apt_cache "Apt download cache ($(_bytes_human "$apt_b"))" \
    TRUE apt_autoremove "Leftover packages, old kernels (${auto_n})" \
    TRUE snap_old "Old snap revisions (${snap_n})" \
    TRUE journals "Old journal + rotated logs (keep 7 days, now ${jn})" \
    TRUE crash "Crash reports / coredumps ($(_bytes_human "$crash_b"))" \
    TRUE dev_caches "pip / npm / font / GPU caches ($(_bytes_human "$dev_b"))" \
    FALSE browser_cache "Browser caches only — not history ($(_bytes_human "$br_b"))" \
    FALSE tracker "Desktop search index cache ($(_bytes_human "$track_b"))" \
    FALSE recently_used "GNOME recent-files list ($(_bytes_human "$rec_b"))" \
    2>/dev/null)" || picked=""

  if [[ -z "${picked// }" ]]; then
    zenity --info --title='X47 Clean' --text='Cancelled — nothing deleted.' 2>/dev/null || true
    return 0
  fi

  if zenity --question --title='X47 Clean' --width=480 \
    --ok-label='Clean now' --cancel-label='Cancel' \
    --text="<b>Clean these:</b>\n${picked}\n\nA terminal will show progress. Your files stay." \
    2>/dev/null; then
    _run_cmd_in_terminal clean --yes ${picked}
    zenity --info --title='X47 Clean' --width=420 \
      --text='Clean started in a terminal.\nThe recycle bin is emptied if you left it ticked.' \
      2>/dev/null || true
  else
    zenity --info --title='X47 Clean' --text='Cancelled — nothing deleted.' 2>/dev/null || true
  fi
}

_apply_in_foreground() {
  set -euo pipefail
  export DEBIAN_FRONTEND=noninteractive
  echo "=== X47 Updates: applying ==="
  if [[ ! -f /etc/apt/sources.list.d/mullvad.list ]] && dpkg -s mullvad-vpn >/dev/null 2>&1; then
    echo "Restoring Mullvad apt source…"
    install -m 0755 -d /usr/share/keyrings
    curl -fsSL https://repository.mullvad.net/deb/mullvad-keyring.asc \
      -o /usr/share/keyrings/mullvad-keyring.asc || true
    codename="$(. /etc/os-release; echo "${VERSION_CODENAME:-noble}")"
    arch_name="$(dpkg --print-architecture)"
    echo "deb [signed-by=/usr/share/keyrings/mullvad-keyring.asc arch=${arch_name}] https://repository.mullvad.net/deb/stable ${codename} main" \
      > /etc/apt/sources.list.d/mullvad.list || true
  fi
  echo "--- apt update ---"
  apt-get update
  echo "--- apt upgrade ---"
  apt-get upgrade -y
  if dpkg -s cursor >/dev/null 2>&1; then
    echo "--- Cursor only-upgrade ---"
    apt-get install --only-upgrade -y cursor || true
  fi
  if dpkg -s code >/dev/null 2>&1; then
    echo "--- VS Code only-upgrade ---"
    apt-get install --only-upgrade -y code || true
  fi
  if command -v snap >/dev/null 2>&1; then
    echo "--- snap refresh ---"
    snap refresh || true
  fi
  echo
  if [[ -f /var/run/reboot-required ]]; then
    echo "DONE — reboot recommended."
    [[ -f /var/run/reboot-required.pkgs ]] && echo "Packages: $(tr '\n' ' ' </var/run/reboot-required.pkgs)"
  else
    echo "DONE — no reboot flag set."
  fi
}

cmd_apply() {
  echo "Applying updates (password may be required)…"
  # Privileged apply as a single script for clear terminal output.
  local tmp
  tmp="$(mktemp /tmp/x47-updates-apply.XXXXXX.sh)"
  cat >"$tmp" <<'EOS'
#!/usr/bin/env bash
set -euo pipefail
export DEBIAN_FRONTEND=noninteractive
echo "=== X47 Updates: applying ==="
if [[ ! -f /etc/apt/sources.list.d/mullvad.list ]] && dpkg -s mullvad-vpn >/dev/null 2>&1; then
  echo "Restoring Mullvad apt source…"
  install -m 0755 -d /usr/share/keyrings
  curl -fsSL https://repository.mullvad.net/deb/mullvad-keyring.asc \
    -o /usr/share/keyrings/mullvad-keyring.asc || true
  host="$(. /etc/os-release; echo "${VERSION_CODENAME:-noble}")"
  codename="$host"
  if ! curl -fsSIL "https://repository.mullvad.net/deb/stable/dists/${codename}/Release" >/dev/null 2>&1; then
    codename=noble
    echo "note: Mullvad has no ${host} suite — using ${codename}"
  fi
  arch_name="$(dpkg --print-architecture)"
  echo "deb [signed-by=/usr/share/keyrings/mullvad-keyring.asc arch=${arch_name}] https://repository.mullvad.net/deb/stable ${codename} main" \
    > /etc/apt/sources.list.d/mullvad.list || true
fi
echo "--- apt update ---"
apt-get update
echo "--- apt upgrade ---"
apt-get upgrade -y
if dpkg -s cursor >/dev/null 2>&1; then
  echo "--- Cursor only-upgrade ---"
  apt-get install --only-upgrade -y cursor || true
fi
if dpkg -s code >/dev/null 2>&1; then
  echo "--- VS Code only-upgrade ---"
  apt-get install --only-upgrade -y code || true
fi
if command -v snap >/dev/null 2>&1; then
  echo "--- snap refresh ---"
  snap refresh || true
fi
echo
if [[ -f /var/run/reboot-required ]]; then
  echo "DONE — reboot recommended."
  [[ -f /var/run/reboot-required.pkgs ]] && echo "Packages: $(tr '\n' ' ' </var/run/reboot-required.pkgs)"
else
  echo "DONE — no reboot flag set."
fi
EOS
  chmod 0755 "$tmp"
  local rc=0
  if [[ "$(id -u)" -eq 0 ]]; then
    bash "$tmp" || rc=$?
  elif [[ -n "${DISPLAY:-}${WAYLAND_DISPLAY:-}" ]] && _have pkexec; then
    pkexec bash "$tmp" || rc=$?
  elif _have sudo; then
    sudo bash "$tmp" || rc=$?
  else
    echo "sudo or pkexec required" >&2
    rm -f "$tmp"
    return 1
  fi
  rm -f "$tmp"
  if [[ "$(id -u)" -ne 0 ]]; then
    _update_claude_and_vscode_ext
  fi
  _status_set last_apply "$(date -Is)"
  _status_set reboot_required "$([[ -f /var/run/reboot-required ]] && echo 1 || echo 0)"
  return "$rc"
}

_run_cmd_in_terminal() {
  local self title cmd
  self="$(readlink -f "$0" 2>/dev/null || realpath "$0" 2>/dev/null || echo "$0")"
  title='X47 Updates & Clean'
  cmd=$(printf '%q ' "$self" "$@")
  if [[ -x "$HOME/.local/bin/wezterm" ]] || _have wezterm; then
    local wt
    wt="$(command -v wezterm 2>/dev/null || echo "$HOME/.local/bin/wezterm")"
    "$wt" start --always-new-process --class x47-updates -- \
      bash -lc "$cmd; echo; read -r -p 'Press Enter to close…' _" &
    return 0
  fi
  if _have gnome-terminal; then
    gnome-terminal --title="$title" -- bash -lc "$cmd; echo; read -r -p 'Press Enter to close…' _" &
    return 0
  fi
  # Fallback: run in current context
  "$self" "$@"
}

_run_apply_in_terminal() {
  _run_cmd_in_terminal apply
}

cmd_updates_gui() {
  if ! _have zenity; then
    echo "zenity not found — falling back to text UI" >&2
    cmd_check
    echo
    read -r -p "Apply all updates now? [y/N] " ans || ans=n
    case "${ans,,}" in
      y|yes) cmd_apply ;;
      *) echo "Cancelled." ;;
    esac
    return 0
  fi

    zenity --info --title='X47 Updates' --width=420 \
    --text='Click OK to check for apt, snap, Cursor, VS Code, and Claude Code updates.\nYou may be asked for your password to refresh package lists.' \
    2>/dev/null || true

  local check_out
  if ! check_out="$(cmd_check 2>&1)"; then
    zenity --error --title='X47 Updates' --width=480 \
      --text="Check failed:\n\n$(printf '%s' "$check_out" | tail -c 1200)" 2>/dev/null || true
    return 1
  fi

  local apt_n snap_n total body
  apt_n="$(_status_get apt_count 0)"
  snap_n="$(_status_get snap_count 0)"
  total=$((apt_n + snap_n))
  body="$(cat "$REPORT_FILE" 2>/dev/null || printf '%s' "$check_out")"

  if [[ "$total" -eq 0 ]]; then
    local extra=""
    [[ -f /var/run/reboot-required ]] && extra="\n\nA reboot is still recommended from earlier updates."
    zenity --info --title='X47 Updates' --width=520 --height=400 \
      --text="<b>Everything looks up to date.</b>${extra}\n\n<pre>$(printf '%s' "$body" | sed 's/&/\&amp;/g; s/</\&lt;/g' | head -c 3500)</pre>" \
      2>/dev/null || zenity --info --title='X47 Updates' --text='Everything looks up to date.' 2>/dev/null || true
    return 0
  fi

  if zenity --question --title='X47 Updates' --width=560 --height=480 \
    --ok-label='Update all' --cancel-label='Cancel' \
    --text="<b>${total} update(s) available</b> (apt: ${apt_n}, snap: ${snap_n}).\n\nApply all updates now? A terminal will show progress.\n\n<pre>$(printf '%s' "$body" | sed 's/&/\&amp;/g; s/</\&lt;/g' | head -c 3000)</pre>" \
    2>/dev/null; then
    _run_apply_in_terminal
    zenity --info --title='X47 Updates' --width=420 \
      --text='Update started in a terminal window.\nWhen it finishes, reboot if the terminal says so.' \
      2>/dev/null || true
  else
    zenity --info --title='X47 Updates' --text='Cancelled — no changes applied.' 2>/dev/null || true
  fi
}

cmd_both_gui() {
  cmd_updates_gui
  cmd_clean_gui
}

cmd_gui() {
  if ! _have zenity; then
    echo "X47 Updates & Clean"
    echo "  1) Check & install updates"
    echo "  2) Clean & tidy"
    echo "  3) Updates, then clean"
    echo "  4) Repair Mullvad apt source"
    local ans
    read -r -p "Choice [1]: " ans || ans=1
    case "${ans:-1}" in
      2) cmd_tidy ;;
      3) cmd_check; read -r -p "Apply updates? [y/N] " a || a=n
         case "${a,,}" in y|yes) cmd_apply ;; esac
         cmd_tidy ;;
      4) cmd_repair_sources ;;
      *) cmd_updates_gui ;;
    esac
    return 0
  fi

  local pick
  pick="$(zenity --list --radiolist --title='X47 Updates & Clean' \
    --width=560 --height=340 \
    --text='Keep this distro updated and tidy. Clean never deletes Documents, Pictures, Desktop, or Downloads.' \
    --column=Pick --column=Id --column=Action \
    --hide-column=2 --print-column=2 \
    TRUE updates 'Check &amp; install updates (apt / snap / Cursor / VS Code / Claude extension)' \
    FALSE clean 'Clean &amp; tidy — empty trash, caches, leftovers (preview first)' \
    FALSE both 'Updates, then clean' \
    FALSE repair 'Repair Mullvad apt source' \
    2>/dev/null)" || pick=""

  case "$pick" in
    updates) cmd_updates_gui ;;
    clean) cmd_clean_gui ;;
    both) cmd_both_gui ;;
    repair) cmd_repair_sources
      if [[ -n "${DISPLAY:-}${WAYLAND_DISPLAY:-}" ]]; then
        zenity --info --title='X47 Updates' --text='Mullvad source repair finished (or was already OK).' 2>/dev/null || true
      fi
      ;;
    *) return 0 ;;
  esac
}

main() {
  local cmd="${1:-}"
  shift || true
  if [[ "$(basename -- "$0")" == "x47-clean" ]]; then
    case "${cmd:-}" in
      ""|gui) cmd=clean-gui ;;
      scan) cmd=clean-scan ;;
    esac
  fi
  case "$cmd" in
    ""|gui) cmd_gui "$@" ;;
    check) cmd_check "$@" ;;
    apply) cmd_apply "$@" ;;
    status) cmd_status "$@" ;;
    repair-sources|repair) cmd_repair_sources "$@" ;;
    clean-scan|scan) cmd_clean_scan "$@" ;;
    clean) cmd_clean "$@" ;;
    tidy) cmd_tidy "$@" ;;
    clean-gui) cmd_clean_gui "$@" ;;
    updates-gui) cmd_updates_gui "$@" ;;
    -h|--help|help) _usage ;;
    *) echo "unknown command: $cmd" >&2; _usage; exit 2 ;;
  esac
}

main "$@"
